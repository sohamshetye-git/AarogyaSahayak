# ====================================================================
# Aarogya Sahayak - Environment Configuration Template
# ====================================================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Database Configuration (SQLite by default for zero-setup local dev; PostgreSQL supported)
DATABASE_URL=sqlite:///./aarogya.db
# DATABASE_URL=postgresql+psycopg2://aarogya:aarogya_secure_pass@localhost:5432/aarogya_db

# Security & JWT
JWT_SECRET=aarogya_super_secret_jwt_key_development_only_2026
JWT_REFRESH_SECRET=aarogya_super_secret_refresh_jwt_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Integration Modes: 'mock' or 'live'
INTEGRATION_MODE=mock
BHASHINI_MODE=mock
LYZR_MODE=mock
GEMINI_MODE=mock
MILVUS_MODE=mock
NEO4J_MODE=mock
TAVILY_MODE=mock
SWYTCHCODE_MODE=mock
N8N_MODE=mock
ABDM_MODE=mock

# AI & Third-Party Service Credentials (Required only when *_MODE=live)
GEMINI_API_KEY=
LYZR_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
TAVILY_API_KEY=
SWYTCHCODE_API_KEY=

# Vector & Graph Databases
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=aarogya_password

# Automation & Interoperability
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=aarogya_n8n_secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# Google Maps Platform Configuration
GOOGLE_MAPS_SERVER_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Portal & Frontend Config
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1/ws
