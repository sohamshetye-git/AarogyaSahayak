# ====================================================================
# Aarogya Sahayak Frontend Environment Variables (.env.example)
# ====================================================================

# Base API URL (pointing to the FastAPI backend)
# Local: http://localhost:8000/api
# Production: https://<render-backend-name>.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket URL (pointing to backend WebSocket host)
# Local: ws://localhost:8000
# Production: wss://<render-backend-name>.onrender.com
VITE_WS_URL=ws://localhost:8000

# Google Maps Browser API Key (for client-side maps & geocoding)
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Application Environment Mode ('development' | 'production')
VITE_APP_ENV=development
