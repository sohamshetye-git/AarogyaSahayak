{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@aarogya/shared-types": ["../../packages/shared-types/index.ts"],
      "@aarogya/design-tokens": ["../../packages/design-tokens/index.ts"],
      "@aarogya/api-client": ["../../packages/api-client/index.ts"],
      "@aarogya/i18n": ["../../packages/i18n/index.ts"],
      "@aarogya/location": ["../../packages/location/index.ts"]
    }

  },
  "include": ["src"]
}
