# ====================================================================
# Aarogya Sahayak Backend Environment Configuration (.env.example)
# ====================================================================

# Environment Mode: 'development' | 'production'
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_PORT=8000
APP_HOST=0.0.0.0

# Database Configuration (PostgreSQL with psycopg2 recommended for production)
# Local: sqlite:///./aarogya.db
# Render PostgreSQL: postgresql+psycopg2://user:password@host:5432/aarogya_db
DATABASE_URL=postgresql+psycopg2://aarogya_user:aarogya_password@localhost:5432/aarogya_db

# Security & JWT
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Integration Modes: 'mock' or 'live'
INTEGRATION_MODE=mock
BHASHINI_MODE=mock
SARVAM_MODE=mock
LYZR_MODE=mock
GEMINI_MODE=mock
GEMINI_MODEL=gemini-2.5-flash
MILVUS_MODE=mock
NEO4J_MODE=mock
TAVILY_MODE=mock
SWYTCHCODE_MODE=mock
N8N_MODE=mock
ABDM_MODE=mock
GOOGLE_MAPS_MODE=auto

# Citizen OTP Mode: 'MOCK', 'TWILIO', 'MSG91'
# NOTE: OTP_MODE=MOCK is strictly blocked in production mode
OTP_MODE=MOCK
DEMO_OTP_CODE=123456
OTP_TEST_CODE=123456
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
GUEST_SESSION_TTL_HOURS=24

# External Service API Keys (Required when running in live mode)
GEMINI_API_KEY=
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_ENABLED=true
SARVAM_TTS_SPEAKER=ritu
LYZR_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
TAVILY_API_KEY=
SWYTCHCODE_API_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Twilio SMS OTP Credentials (when OTP_MODE=TWILIO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 SMS OTP Credentials (when OTP_MODE=MSG91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
OTP_SMS_PROVIDER_API_KEY=
OTP_SMS_SENDER_ID=

# Vector & Graph Databases (Optional when *_MODE=mock)
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Automation & Interoperability
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=aarogya_n8n_secret
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway/v0.5
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
